<?xml version="1.0" encoding="utf-8"?>
<!-- Плавающий значок. Нажатие раскрывает кнопки:
     в ожидании «Запись» и «Скрыть», во время записи «Пауза» и «Стоп». -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ov_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingTop="6dp"
    android:paddingRight="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/ov_dot"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_overlay_idle" />

    <TextView
        android:id="@+id/ov_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:minWidth="52dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/ov_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/ov_record"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_overlay_btn"
            android:contentDescription="@string/main_record"
            android:src="@drawable/ic_rec_red"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/ov_close"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_overlay_btn"
            android:contentDescription="@string/bubble_close"
            android:src="@drawable/ic_close"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/ov_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_overlay_btn"
            android:src="@drawable/ic_pause"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/ov_stop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_overlay_btn"
            android:contentDescription="@string/notif_stop"
            android:src="@drawable/ic_stop"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
