<?xml version="1.0" encoding="utf-8"?>
<!-- Название сверху, текущее значение под ним: помещается на любой ширине. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/row_gap"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_min_height"
    android:orientation="vertical"
    android:paddingLeft="@dimen/row_padding_h"
    android:paddingTop="10dp"
    android:paddingRight="@dimen/row_padding_h"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/appText"
        android:textSize="@dimen/row_title_size" />

    <TextView
        android:id="@+id/row_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="?attr/appTextSecondary"
        android:textSize="@dimen/row_value_size" />
</LinearLayout>
